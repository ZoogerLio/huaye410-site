---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import EndBanner from '../components/EndBanner.astro';
import { externalLinkProps } from '../lib/content';

const [profileEntries, projects] = await Promise.all([
  getCollection('profile'),
  getCollection('projects'),
]);
const profile = profileEntries[0].data;
const sortedProjects = projects.sort((a, b) => b.data.period.localeCompare(a.data.period));
---

<BaseLayout title={`Research | ${profile.name}`} description={`Research interests and selected projects by ${profile.name}.`}>
  <Hero
    name={profile.name}
    image={profile.heroImage}
    navigation={profile.navigation}
  />

  <main id="main-content">
    {profile.interests.length > 0 && (
      <section class="section page-width">
        <div class="section-heading">
          <p class="section-kicker">Research</p>
          <h2>Areas of Interest</h2>
        </div>
        <div class="interest-list">
          {profile.interests.map((interest, index) => (
            <article class="interest-item">
              <span class="item-number">{String(index + 1).padStart(2, '0')}</span>
              <div>
                <h3>{interest.title}</h3>
                <p>{interest.description}</p>
              </div>
            </article>
          ))}
        </div>
      </section>
    )}

    {sortedProjects.length > 0 && (
      <section class="section section-tinted research-projects">
        <div class="page-width">
          <div class="section-heading">
            <p class="section-kicker">Current Work</p>
            <h2>Selected Research</h2>
          </div>
          <div class="project-list">
            {sortedProjects.map((project) => (
              <article class="project-item">
                <p class="project-period">{project.data.period}</p>
                <h3>{project.data.title}</h3>
                <p>{project.data.description}</p>
                {project.data.url && <a class="text-link" href={project.data.url} {...externalLinkProps(project.data.url)}>Project details</a>}
              </article>
            ))}
          </div>
        </div>
      </section>
    )}
    <EndBanner image={profile.footerImage} />
  </main>

</BaseLayout>
