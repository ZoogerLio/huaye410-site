---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import EndBanner from '../components/EndBanner.astro';
import { withBase } from '../lib/content';

const [profileEntries, experience] = await Promise.all([
  getCollection('profile'),
  getCollection('experience'),
]);

const profile = profileEntries[0].data;
const sortedExperience = experience.sort((a, b) => b.data.period.localeCompare(a.data.period));
const title = `${profile.name} | Academic Homepage`;
---

<BaseLayout title={title} description={profile.introduction}>
  <Hero
    name={profile.name}
    image={profile.heroImage}
    navigation={profile.navigation}
  />

  <main id="main-content">
    <section id="about" class="section section-about page-width">
      <div class="about-copy">
        <div class="portrait-wrap">
          <img src={withBase(profile.profileImage)} alt={`Portrait of ${profile.name}`} width="720" height="480" />
        </div>
        <p class="section-kicker">Biography</p>
        <h2>{profile.name}</h2>
        <p class="role-line">{profile.role}<br />{profile.affiliation}</p>
        {profile.biography.map((paragraph) => <p>{paragraph}</p>)}
        <div class="button-row">
          <a class="button" href={`mailto:${profile.email}`}>Email me</a>
        </div>
      </div>
    </section>

    {sortedExperience.length > 0 && (
      <section id="experience" class="section section-rule experience-section page-width">
        <div class="section-heading">
          <h2>Education &amp; Experience</h2>
        </div>
        <div class="timeline">
          {sortedExperience.map((item) => (
            <article class="timeline-item">
              <p class="timeline-period">{item.data.period}</p>
              <div>
                <p class="timeline-type">{item.data.type}</p>
                <h3>{item.data.role}</h3>
                <p class="timeline-institution">{item.data.institution}</p>
                {item.data.description && <p>{item.data.description}</p>}
              </div>
            </article>
          ))}
        </div>
      </section>
    )}

    <EndBanner image={profile.footerImage} />

  </main>

</BaseLayout>
