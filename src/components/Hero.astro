---
import Header from './Header.astro';
import { withBase } from '../lib/content';

interface NavItem {
  label: string;
  href: string;
}

interface Props {
  name: string;
  image: string;
  navigation: NavItem[];
}

const { name, image, navigation } = Astro.props;
---

<section class="hero" style={`--hero-image: url('${withBase(image)}'); --divider-image: url('${withBase('/images/cloud-divider.png')}')`}>
  <Header name={name} navigation={navigation} />
  <div class="hero-overlay"></div>
  <div class="hero-cloud-divider" aria-hidden="true"></div>
</section>
